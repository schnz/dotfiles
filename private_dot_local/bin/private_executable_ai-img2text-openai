#!/bin/bash
set -euo pipefail

[[ -f ~/.config/environment ]] && . ~/.config/environment

if ! [[ -v OPENAI_API_KEY ]]; then
	echo "OPENAI_API_KEY environment variable is not set"
	exit 1
fi

encoded=$(base64 -w0 "$1")
mimetype=$(file --mime-type -b "$1")

echo "data:${mimetype};base64,${encoded}" |
jq \
  --raw-input \
  --compact-output \
  '{
    "model": "gpt-4o-mini",
    "messages": [
      {
        "role": "system",
        "content": "Identify all text in the attached image and convert it to markdown. Return only the markdown with no explanation text. Do not omit any textual content from the image."
      },
      {
        "role": "user",
        "content": [
          {
            "type": "image_url",
            "image_url": { "url": . }
          }
        ]
      }
    ]
  }' |
curl https://api.openai.com/v1/chat/completions \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer ${apikey}" \
  -s \
  -d @- |
jq -r ".choices[].message.content"
