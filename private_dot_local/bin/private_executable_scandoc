#!/bin/bash
set -euo pipefail

BASENAME=$(basename "$0")
usage() {
  cat <<EOF
usage: $BASENAME <mode> <dpi> [page-height] [-- additional scanimage options]

  mode        : "simplex" or "duplex"
  dpi         : resolution in DPI (e.g. 300)
  page-height : optional page height in mm (default: 297.0)
  Any remaining arguments are forwarded to scanimage.

Examples:
  $BASENAME duplex 300
  $BASENAME simplex 600 --swcrop
EOF
}

if [ $# -lt 2 ]; then
  usage
  exit 1
fi

MODE="$1"
DPI="$2"
shift 2

case "$MODE" in
  simplex)
    BATCH_COUNT=1
    SOURCE="Card Front"
    ;;
  duplex)
    BATCH_COUNT=2
    SOURCE="Card Duplex"
    ;;
  *)
    echo "Error: mode must be 'simplex' or 'duplex' (got '$MODE')" >&2
    usage
    exit 2
    ;;
esac

# If the next argument exists and does NOT start with '-', treat it as page-height.
# Otherwise use default page-height and leave remaining args for scanimage.
if [ $# -gt 0 ] && [[ "$1" != -* ]]; then
  PAGE_HEIGHT="$1"
  shift
else
  PAGE_HEIGHT="297.0"
fi

DEVICE='fujitsu:ScanSnap iX1300:1706392'
OUTNAME="scan_$(date '+%Y%m%d_%H%M%S').%d.jpg"

scanimage -d "$DEVICE" --source "$SOURCE" --mode "Color" \
  --resolution "$DPI" --format jpeg --batch="$OUTNAME" \
  --batch-count="$BATCH_COUNT" --page-height "$PAGE_HEIGHT" "$@"
