# https://github.com/alacritty/alacritty-theme/blob/master/themes/snazzy.toml

# Default colors
[colors.primary]
background = '#282a36'
foreground = '#eff0eb'

# Normal colors
[colors.normal]
black   = '#282a36'
red     = '#ff5c57'
green   = '#5af78e'
yellow  = '#f3f99d'
blue    = '#57c7ff'
magenta = '#ff6ac1'
cyan    = '#9aedfe'
white   = '#f1f1f0'

# Bright colors
[colors.bright]
black   = '#686868'
red     = '#ff5c57'
green   = '#5af78e'
yellow  = '#f3f99d'
blue    = '#57c7ff'
magenta = '#ff6ac1'
cyan    = '#9aedfe'
white   = '#f1f1f0'

[font]
size = 10.0

[font.normal]
{{ if has "ttf-liberation-mono-nerd" .packages -}}
family = "LiterationMono Nerd Font Mono"
{{- else if has "ttf-liberation" .packages -}}
family = "Liberation Mono"
{{- end }}
style = "Regular"

[[keyboard.bindings]]
action = "ToggleFullscreen"
key = "F11"

[window]
decorations = "none"

[window.dimensions]
columns = 180
lines = 64
